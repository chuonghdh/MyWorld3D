{
  "name": "myworld3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Top-down 3D procedural city simulation (MyWorld3D)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm run lint && vitest run && vite build",
    "lint": "eslint src tests --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bridge": "node tools/agent-bridge/server.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "mp4-muxer": "5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "suncalc": "^1.9.0",
    "three": "^0.170.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.10",
    "vitest": "^5.1.0"
  }
}
